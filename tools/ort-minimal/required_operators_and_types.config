# Generated from the SHIPPING fp16 model, with runtime optimisations enabled:
#
#   .venv/bin/python -m onnxruntime.tools.convert_onnx_models_to_ort <dir> \
#       --enable_type_reduction --output_dir <out>
#   cp <out>/required_operators_and_types.with_runtime_opt.config \
#      tools/ort-minimal/required_operators_and_types.config
#
# Note it is the .with_runtime_opt.config that is used, NOT the plain one --
# see the Dockerfile's --enable_runtime_optimizations for why. The plain
# config bakes in FusedConv and a float32 Conv; this one keeps Cast accepting
# MLFloat16, which is what lets the fp16 weights stay fp16 on disk.
#
# HardSwish does not appear: ORT decomposes it into HardSigmoid + Mul.
ai.onnx;1;GlobalAveragePool
ai.onnx;6;HardSigmoid
ai.onnx;11;Conv{"inputs": {"0": ["float"]}}
ai.onnx;13;Cast{"inputs": {"0": ["MLFloat16", "float"]}, "outputs": {"0": ["float"]}},Flatten,Gemm{"inputs": {"0": ["float"]}},ReduceMean{"inputs": {"0": ["float"]}}
ai.onnx;14;Add{"inputs": {"0": ["float"]}},Mul{"inputs": {"0": ["float"]}},Relu{"inputs": {"0": ["float"]}}
