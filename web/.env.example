# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never hold a real token.
#
# The token needs one permission: Account -> Cloudflare Pages -> Edit, with
# Account Resources restricted to the deploying account. Create it at
# https://dash.cloudflare.com/profile/api-tokens (My Profile -> API Tokens).
#
# Note the permission is account-scoped, not project-scoped: a token that can
# deploy sensing-ponds can deploy every Pages project on that account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
